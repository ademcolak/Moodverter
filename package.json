{
  "name": "moodverter",
  "private": true,
  "version": "0.1.0",
  "description": "YouTube şarkı arama, ekleme ve çalma odaklı cross-platform masaüstü widget",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:artifacts": "rm -rf dist .smoke-dist src-tauri/target node_modules/.vite",
    "rebuild:full": "pnpm run clean:artifacts && pnpm run build && (cd src-tauri && cargo check)",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "smoke:compile": "rm -rf .smoke-dist && tsc -p tsconfig.smoke.json && printf '{\"type\":\"commonjs\"}\\n' > .smoke-dist/package.json",
    "smoke:test": "pnpm run smoke:compile && node --test .smoke-dist/tests/*.test.js",
    "smoke:regression-gate": "pnpm run smoke:compile && node --test --test-name-pattern=\"regression gate|detects Hit@K regression per scope\" .smoke-dist/tests/transition-evaluation.smoke.test.js",
    "smoke:transition-gating": "pnpm run smoke:compile && node --test .smoke-dist/tests/transition-gating.smoke.test.js",
    "smoke:transition-decision": "pnpm run smoke:compile && node --test .smoke-dist/tests/transition-decision.smoke.test.js",
    "smoke:retrieval-gate": "pnpm run smoke:compile && node --test --test-name-pattern=\"evaluateRetrievalQuality\" .smoke-dist/tests/retrieval-index.smoke.test.js",
    "smoke:benchmark-before-after-report": "pnpm run smoke:compile && node .smoke-dist/tests/benchmark-before-after-report.cli.js --output ./dataset/output/benchmark-before-after.report.json",
    "smoke:real-mini-run": "node scripts/real-mini-run-quality-gate.mjs",
    "smoke:tuning-loop-dry-run": "node scripts/tuning-loop-dry-run.mjs",
    "runtime:drift-report": "pnpm run smoke:compile && node .smoke-dist/tests/runtime-drift-report.cli.js",
    "eval:report": "pnpm run smoke:compile && node .smoke-dist/tests/eval-report.cli.js",
    "tuning:loop": "pnpm run smoke:compile && node .smoke-dist/tests/tuning-loop.cli.js",
    "qa:auto": "node scripts/qa-auto.mjs",
    "pipeline:quality": "node scripts/quality-pipeline.mjs",
    "dataset:pipeline": "node scripts/dataset-pipeline.mjs",
    "dataset:build:dev": "pnpm run dataset:pipeline -- --config ./configs/dataset-pipeline.example.json",
    "dev:with-dataset": "node scripts/dev-with-dataset.mjs",
    "dev:web:with-dataset": "node scripts/dev-with-dataset.mjs --web",
    "oss:guard": "node scripts/oss-source-guard.mjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.0.4"
  }
}
