{
  "name": "moodverter",
  "private": true,
  "version": "0.1.0",
  "description": "YouTube şarkı arama, ekleme ve çalma odaklı cross-platform masaüstü widget",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "smoke:compile": "rm -rf .smoke-dist && tsc -p tsconfig.smoke.json && printf '{\"type\":\"commonjs\"}\\n' > .smoke-dist/package.json",
    "smoke:test": "pnpm run smoke:compile && node --test .smoke-dist/tests/*.test.js",
    "smoke:regression-gate": "pnpm run smoke:compile && node --test .smoke-dist/tests/transition-evaluation.smoke.test.js --test-name-pattern='regression gate|detects Hit@K regression per scope'",
    "eval:report": "pnpm run smoke:compile && node .smoke-dist/tests/eval-report.cli.js",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.0.4"
  }
}
